# Copie este arquivo para .env e ajuste os valores.

# Chave secreta das sessões. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Caminho do banco SQLite (opcional). Padrão: estudos.db na pasta do app.
# DATABASE_PATH=/home/seuusuario/revisa/estudos.db

# Fuso usado para saber qual é o "hoje" (o servidor do PythonAnywhere roda em UTC).
APP_TZ=America/Sao_Paulo

# 1 = modo debug (só para desenvolvimento local)
FLASK_DEBUG=0
